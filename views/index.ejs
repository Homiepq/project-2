<!DOCTYPE html>
<html lang="en">
<%- include('head.ejs') -%>
<body>
    <%- include('header.ejs') -%>
    <main>
        <div class="wrapper">
            <% products.forEach( (product) => { %>
                <a href="/post/<%= product.id %>">
                    <div class="ad">
                        <img src="/uploads/<%= product.image[0] %>" alt="">
                        <h3><%= product.title %></h3>
                        <p><%= product.description %></p>
                    </div>
                </a>
            <% }) %>
        </div>
        <%- include('modal.ejs') -%>
        <button id="add">+</button> 
    </main>
    <%- include('footer.ejs') -%>
</body>
</html>